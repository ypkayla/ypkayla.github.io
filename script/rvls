local function fn36(arg, arg2, arg3)
local n = os.clock() + arg3

for _, v121 in arg2, nil, nil do
local v122 = arg:FindFirstChild(v121)

if v122 ~= nil then
arg = v122
else
local n33 = n - os.clock()
if n33 <= 0 then
return nil
end
arg = arg:WaitForChild(v121, n33)
end

if arg == nil then
return nil
end
end

return arg
end

