end

index2._UpdateRender = function(arg, arg2, arg3, arg4)
arg:_UpdateFovRender(arg2, arg3, arg4)
arg:_UpdateTextIndicator(arg4)
end

index2._UpdateFovRender = function(arg, arg2, arg3, arg4)
local circle = arg4.Fov.Circle
local flag19 = arg4.Enabled and circle.Visible and arg3 ~= nil
local fovRender = arg._fovRender
local fovFollower = arg._fovFollower
fovRender:SetVisible(flag19)
local v134 = v133()
fovFollower:SetInitial(v134)
local followTarget = circle.FollowTarget
fovFollower:SetTarget(flag19 and followTarget.Enabled and arg._targetScreenPosition or nil)

if flag19 then
local position = followTarget.Enabled and fovFollower:GetPosition() or v134
fovRender:SetPosition(UDim2.fromOffset(position.X, position.Y))
end

fovRender:Update(arg2)
end

index2._UpdateTextIndicator = function(arg, arg2)
local manipulate = arg2.Manipulate
if not (manipulate.Enabled and manipulate.ShowIndicator) then
arg._textIndicatorList:Hide("Manipulated")
return
end
local currentHitbox = arg._currentHitbox
if currentHitbox == nil or arg._visibleOriginByHitbox[currentHitbox] == nil then
arg._textIndicatorList:Hide("Manipulated")
return
end
arg._textIndicatorList:Show("Manipulated", "Manipulated", v120.Manipulate)
end

index2._Reset = function(arg)
arg._currentTarget = nil
arg._currentHitbox = nil
arg._targetScreenPosition = nil
arg._targetAcquisition:Reset()
end

index2._UpdateTarget = function(arg, arg2, arg3, arg4)
if not arg._active or arg3 == nil or v128(arg3, arg4.ActivationConditions) then
arg:_Reset()
return
end
local v134, v135 = arg._targetSelection:SelectBest()
if v134 == nil or v135 == nil then
arg:_Reset()
return
end
local circle = arg4.Fov.Circle

if circle.Visible and circle.FollowTarget.Enabled then
arg._targetScreenPosition = arg._computeTargetPoint(workspace.CurrentCamera, v133(), v135)
else
arg._targetScreenPosition = nil
end

if not arg._targetAcquisition:Acquire(arg2, v134, arg4.ReactionTime, arg4.SwitchDelay) then
return
end
arg._currentTarget = v134
arg._currentHitbox = v135
end

index2._HandleInput = function(arg, arg2)
if arg2.Type ~= "StartShooting" then
return
end
local currentHitbox = arg._currentHitbox
if currentHitbox == nil then
return
end
local inner = arg._playerContext.Inner
if inner == nil then
return
end

if not (data.SilentAim.ActivationChance / 100 >= math.random()) then
return
end
local v134 = inner.FighterState:FindItemByObjectId(arg2.ObjectId)
if v134 == nil then
return
end

if rawGet(rawGet(v134, "Info"), "Type") ~= "Gun" then
return
end
local v135, v136 = arg._computeTargetPoint(workspace.CurrentCamera, v133(), currentHitbox)
local v137 = arg2.Args["\1"]
if type(v137) ~= "table" then
return
end
local v138 = v116.decode(v137["\0"])
local v139 = v116.decode(v137["\1"])
if v138 == nil or v139 == nil then
return
end
local position = v138.Position
local v140 = v131(position, currentHitbox, v136)
if v140 == nil then
return
end
local v141 = arg._visibleOriginByHitbox[currentHitbox]

if v141 ~= nil then
v137["\0"] = v116.encode(CFrame.lookAt(v141, v136))
v137["\1"] = v116.encode(CFrame.lookAt(v141, v136))
else
v137["\0"] = v116.encode(CFrame.lookAt(position, v136))
v137["\1"] = v116.encode(CFrame.lookAt(v139.Position, v136))
end

v137["\2"] = currentHitbox
v137["\3"] = v116.encode(CFrame.new(v140))
end

index2.Destroy = function(arg)
