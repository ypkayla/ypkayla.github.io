local function fn36(arg)
local keypoints = arg.Keypoints
local value = keypoints[constants[63]].Value

for i = 2, #keypoints do
if keypoints[i].Value ~= value then
return false
end
end

return true
end

local index2 = {}
index2.__index = index2

index2.new = function(arg)
local tbl18 = {
_trove = v116.new("esp.Skeleton"),
_container = arg,
_limbConnectionByPart = {},
_color = Color3.new(1, 1, 1),
_transparency = 0,
_gradientEnabled = false,
_gradientColor = ColorSequence.new(Color3.new(1, 1, 1)),
_thickness = 1,
_anyVisible = false,
}

setmetatable(tbl18, index2)
return tbl18
end

index2.SelectModel = function(arg, model)
if arg._model ~= nil then
return
end
arg._model = model
arg:_CacheLimbConnections(model)
end

index2.SetLook = function(arg, gradientColor, transparency, thickness)
arg._thickness = thickness
local gradientEnabled = not fn36(gradientColor)
local color = gradientColor.Keypoints[1].Value
local flag19 = arg._color ~= color

if flag19 then
arg._color = color
end

local flag20 = arg._transparency ~= transparency

if flag20 then
arg._transparency = transparency
end

if gradientEnabled ~= arg._gradientEnabled or gradientEnabled and gradientColor ~= arg._gradientColor then
arg._gradientEnabled = gradientEnabled
arg._gradientColor = gradientColor

for _, v119 in arg._limbConnectionByPart, nil, nil do
v119.Gradient.Enabled = gradientEnabled

if gradientEnabled then
v119.Gradient.Color = gradientColor
v119.Frame.BackgroundColor3 = Color3.new(1, 1, constants[63])
else
v119.Frame.BackgroundColor3 = color
end

v119.Frame.BackgroundTransparency = transparency
end

return
end

if flag19 and not arg._gradientEnabled then
for _, v119 in arg._limbConnectionByPart, nil, nil do
v119.Frame.BackgroundColor3 = color
end
end

if flag20 then
for _, v119 in arg._limbConnectionByPart, nil, nil do
v119.Frame.BackgroundTransparency = transparency
end
end
end

index2.DeselectModel = function(arg)
if arg._model == nil then
return
end
arg._model = nil
arg._trove:Clean()
arg:_ClearAllLimbConnections()
end

index2._CacheLimbConnections = function(I,W)I._trove:Clean();I:_ClearAllLimbConnections();for N,P in W:GetChildren()do if not(P:IsA("BasePart")and  v115 [P.Name])then continue;end;N=P:FindFirstChildOfClass("AnimationConstraint");if N==nil then continue;end;local a,e=N.Attachment0,N.Attachment1;if a~=nil and e~=nil then I:_AddLimbConnection(P,a.Parent,e.Parent);end;end;I._trove:Connect(W.ChildAdded,function(N)if not(N:IsA("BasePart")and  v115 [N.Name])then return;end;local P=N:FindFirstChildOfClass("AnimationConstraint");if P==nil then return;end;local a,e=P.Attachment0,P.Attachment1;if a~=nil and e~=nil then I:_AddLimbConnection(N,a.Parent,e.Parent);end;end);I._trove:Connect(W.ChildRemoved,function(W)if not(W:IsA("BasePart")and  v115 [W.Name])then return;end;I:_RemoveLimbConnection(W);end);end

index2._AddLimbConnection = function(arg, arg2, arg3, arg4)
