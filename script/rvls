local function fn35()
    local player = cloneref(game:GetService("Players")).LocalPlayer
    local uiRuntime = modules.aE()
    modules.hN()
    local store = modules.bG()
    local cleanup = modules.n()
    local configureIdentity = modules.h_()
    local configureSettings = modules.ij()
    local configureCosmetics = modules.ip()
    local configureWorld = modules.iw()
    local configureExtra = modules.i_()
    local configureWorldTabs = modules.je()
    return function(runtime)
        local menu = uiRuntime.CreateMenu({
            Title = "GHP | Rivals",
            Icon = uiLibrary.DefaultLogo,
            Directory = "GHP/Rivals",
            Config = runtime.ReactiveStoreAdapter,
            ResolveFont = function(fontName) return modules.az():Get(fontName) end,
            ColorAnimation = runtime.ColorAnimation,
            Persistence = store,
            State = runtime.GeneralState,
            StateData = runtime.GeneralStateData,
            OnUnload = function() cleanup:Destroy() end,
        })
        cleanup:Add(menu)
        local identities = runtime.PlayerIdentities
        menu:SetWatermarkUsername(identities:GetPresented(player))
        cleanup:Connect(identities.IdentityChanged, function(changedPlayer)
            if changedPlayer == player then
                menu:SetWatermarkUsername(identities:GetPresented(player))
            end
        end)
        configureIdentity(runtime, menu)
        configureSettings(runtime, menu)
        configureCosmetics(runtime, menu)
        configureWorld(runtime, menu)
        configureExtra(runtime, menu)
        configureWorldTabs(runtime, menu)
        local musicSound = cleanup:Add(Instance.new("Sound"))
        musicSound.Name = "GHPRivalsMusicPlayer"
        musicSound.Volume = 0.5
        musicSound.Looped = true
        musicSound.Parent = SoundService
        local musicTab = menu:AddTab({ Label = "Music Player", Icon = "lucide:volume-2" })
        local musicSection = musicTab:Grid({ Columns = 1 }):AddSection({ Title = "GHP Music Player", Side = "full" })
        musicSection:AddTextBox({
            Label = "Roblox audio asset ID",
            Placeholder = "Digits only",
            FocusLostOnly = true,
            OnChanged = function(value)
                local assetId = tostring(value):match("^%s*(%d+)%s*$")
                if assetId then
                    musicSound.SoundId = "rbxassetid://" .. assetId
                end
            end,
        })
        musicSection:AddSlider({
            Label = "Volume",
            Min = 0,
            Max = 1,
            Step = 0.05,
            Default = 0.5,
            OnChanged = function(value) musicSound.Volume = math.clamp(tonumber(value) or 0.5, 0, 1) end,
        })
        musicSection:AddToggle({
            Label = "Loop track",
            Default = true,
            OnChanged = function(value) musicSound.Looped = value end,
        })
        musicSection:AddButton({
            Label = "Play track",
            OnClick = function()
                if musicSound.SoundId == "" then
                    uiLibrary.GetNotifications():Notify("Enter a Roblox audio asset ID first.", { Lifetime = 3 })
                    return
                end
                musicSound:Play()
            end,
        })
        musicSection:AddButton({ Label = "Stop track", OnClick = function() musicSound:Stop() end })
        menu:AddSettingsTab()
        menu:SetVisible(runtime.GeneralStateData.SilentLoad ~= true, true)
    end
end

