--  Report library errors through the GHP console.
local GlobalTrove = modules.n()
modules.w().ensureStorageDirectories("GHP/Rivals")
modules.w().ensureStorageDirectories("GHP_scripts/fonts")
modules.w().ensureStorageDirectories("GHPrebuild/cache")
for _, sub in ipairs({ "cosmetics/states", "crosshair_textures", "esp_images", "movement_recorder" }) do
    modules.w().ensureStorageDirectories("GHPrebuild/rivals/" .. sub)
end

modules.b().use({ Report = function(_, e)
    local detail = type(e) == "table" and (e.Detail or e.Operation) or e
    warn("[GHP] " .. tostring(detail))
end })

local boot = (function()
    local store = modules.bG()
    local profiles = GlobalTrove:Add(modules.bN().new(store))
    store:UseMiddleware(profiles)
    local fonts = modules.az()
    GlobalTrove:Add(modules.aB().use(store, { "Notifications" }, { "Theme" }, function(f) return fonts:Get(f) end,
        modules.bI().Notifications))

    local reporter = GlobalTrove:Add(modules.ad().new())
    local state = GlobalTrove:Add(modules.ae().new("GHP/Rivals"))
    local stateData = state:Load()
    if stateData.AutoLoad and stateData.AutoLoadConfigName ~= nil then
        local r = reporter:ReportResult(store:LoadFromFile(stateData.AutoLoadConfigName))
        if not r.Ok then
            local text = "Failed to auto-load the selected config"
            if string.find(r.Error.Detail, "newer than current version", 1, true) ~= nil then
                text = "Your selected config was saved by a newer version - update or pick another config"
            end
            modules.aB().get():Notify(text)
        elseif #modules.bc().takeDroppedPaths() > 0 then
            modules.aB().get():Notify("Some saved settings could not be restored and were reset to defaults")
        end
    end

    local Theme = modules.A()
    local theme = store.Data.Theme
    if theme ~= nil then
        for k, v in next, theme do
            if Theme.Tokens[k] ~= nil and typeof(v) == "Color3" then Theme.refresh(k, v) end
        end
    end

    local registry = GlobalTrove:Add(modules.bK().new())
    local identities = GlobalTrove:Add(modules.bL().new(registry))
    local tags = GlobalTrove:Add(modules.bM().new(registry))
    GlobalTrove:Add(modules.bR().new(tags, registry))
    GlobalTrove:Add(modules.bZ().new(identities))
    local avatar = GlobalTrove:Add(modules.b6().new(registry))

    return {
        StoreProfiles = profiles,
        PlayerRegistry = registry,
        PlayerIdentities = identities,
        PlayerTags = tags,
        DecoratorFactory = avatar ~= nil and avatar:GetDecoratorFactory() or nil,
        ArmAvatarSpoofer = function() avatar:Arm() end,
        GeneralState = state,
        GeneralStateData = stateData,
    }
end)()

function K.Unload()
    if K.destroyed then return end
    K.destroyed = true
    for _, f in ipairs(K.cleanups) do pcall(f) end
    pcall(function() GlobalTrove:Destroy() end)
    if environment.GhpWtf == K then environment.GhpWtf = nil end
end

modules.j1()(boot)
