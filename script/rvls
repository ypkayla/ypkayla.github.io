index2._ResolveAnimationId = function()
local animationPlayer = v116.Data.AnimationPlayer
local customId = animationPlayer.CustomId

if type(customId) == "string" then
local v119 = string.match(customId, "%d+")
if v119 ~= nil then
return v119
end
end

return v115.IdByName[animationPlayer.Animation]
end

index2._Apply = function(arg, arg2)
arg:_Stop()
if not v116.Data.AnimationPlayer.Enabled then
return
end
local humanoid = arg._humanoid
if humanoid == nil then
return
end
local animator = humanoid:FindFirstChildOfClass("Animator")

if animator == nil then
arg._animatorWait = humanoid.ChildAdded:Connect(function(child)
if child:IsA("Animator") then
arg:_Apply(true)
end
end)

return
end

local v119 = arg:_ResolveAnimationId()
