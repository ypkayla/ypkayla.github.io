-- Standalone GHP Rivals product.
-- Credits: GHP (GhostGamer / ypkayla).
local environment = getgenv()
local function loadGhpUi()
    local source = game:HttpGet("https://raw.githubusercontent.com/ypkayla/GHPhook_UI/main/UI_Library.lua")
    local compile = assert(loadstring, "GHP Rivals requires loadstring")
    local chunk = assert(compile(source), "Could not compile the GHP UI library")
    local result = chunk()
    local ui = type(result) == "function" and result() or result
    assert(type(ui) == "table" and type(ui.CreateMenu) == "function", "GHP UI library is unavailable")
    return ui
end
local function unloadPrevious(key)
    local previous = environment[key]
    if previous and previous.Unload then
        pcall(previous.Unload)
    end
end
unloadPrevious("GhpWtf")
unloadPrevious("GhpRivalsSkinchanger")
if not game:IsLoaded() then game.Loaded:Wait() end

local K = { connections = {}, cleanups = {}, destroyed = false }
environment.GhpWtf = K

