index2._PrepareSnapshot = function(arg, fighterState, arg2)
local esp = v115.Data.Esp
local enemy, enemyEnabled

if fighterState.IsEnemy then
enemy = esp.Enemy
enemyEnabled = arg._enemyEnabled
else
enemy = esp.Team
enemyEnabled = arg._teamEnabled
end

enemyEnabled = arg._mainEnabled and enemyEnabled and fighterState.EnvironmentId ~= nil
local presentedDisplay

if arg._useDisplayName then
presentedDisplay = arg._playerIdentities:GetPresentedDisplay(fighterState.Player)
else
presentedDisplay = arg._playerIdentities:GetPresented(fighterState.Player)
end

local snapshot = arg._snapshot
snapshot.Enabled = enemyEnabled
snapshot.FighterState = fighterState
snapshot.AliveState = arg2.AliveState
snapshot.PlayerSettings = enemy
snapshot.DisplayedName = presentedDisplay
arg2.PlayerSettings = enemy
end

index2._ComputeRect = function(arg, arg2, arg3, arg4)
local aliveState = arg2.AliveState
if aliveState == nil then
return nil, nil
end
local calculator = arg2.Calculator

if arg4 or calculator == nil then
local overrideRectSize = arg._overrideRectSize
if overrideRectSize.Enabled then
return v123(aliveState.Model, arg3.HalfFovTan, arg3.ViewportHeight, overrideRectSize.Width, overrideRectSize.Height)
end
return v123(aliveState.Model, arg3.HalfFovTan, arg3.ViewportHeight)
end

return calculator:Compute(arg3.HalfFovTan, arg3.ViewportWidth, arg3.ViewportHeight, arg3.CameraCFrame:GetComponents())
end

index2._EnsureCalculator = function(arg, arg2)
local main = v115.Data.Esp.Main
local calculator = arg2.Calculator

if not main.Enabled or main.Mode == "Static" then
if calculator == nil then
return
end
arg2.Trove:Remove(calculator)
arg2.Calculator = nil
elseif main.Mode == "Dynamic" then
if calculator ~= nil then
return
end
local aliveState = arg2.AliveState
if aliveState == nil then
return
end
arg2.Calculator = arg2.Trove:Add(v117.new(aliveState.Model))
end
end

