local v118 = cloneref(game:GetService("Workspace"))
local localPlayer = v117.LocalPlayer
local tbl18 = { "LeftFoot", "RightFoot" }
local tbl19 = { "Left Leg", "Right Leg" }
local vector = Vector3.new(2, 0.2, 2)
local index2 = {}
index2.__index = index2

local function fn36(arg)
local parent = arg.Parent
if parent == nil then
return nil
end

if parent:IsA("BasePart") then
return parent
end

if parent:IsA("Attachment") then
local parent2 = parent.Parent
if parent2 ~= nil and parent2:IsA("BasePart") then
return parent2
end
end

return nil
end

local function fn37(arg)
local tbl20 = {}

for _, v119 in tbl18, nil, nil do
local v120 = arg:FindFirstChild(v119)

if v120 ~= nil and v120:IsA("BasePart") then
table.insert(tbl20, v120)
end
end

if #tbl20 > 0 then
return tbl20
end

for _, v119 in tbl19, nil, nil do
local v120 = arg:FindFirstChild(v119)

if v120 ~= nil and v120:IsA("BasePart") then
table.insert(tbl20, v120)
end
end

return tbl20
end

local function fn38(arg)
if arg <= 0.5 then
return Color3.new(arg * 2, 1, 0)
end
return Color3.new(1, (1 - arg) * 2, 0)
end

local function fn39(arg)
local v119, v120 = arg.CFrame:ToEulerAnglesYXZ()
return CFrame.new(arg.Position - Vector3.new(0, arg.Size.Y * 0.5, 0)) * CFrame.Angles(constants[186], v120, 0)
end

local function fn40(arg)
return constants[63] - (1 - arg) ^ 5
end

index2.new = function(arg)
local v119 = v116.new()
local folder = Instance.new("Folder")
folder.Name = "RivalsSoundVisualizer"
folder.Parent = v118
v119:Add(folder)

local tbl20 = {
_trove = v119,
_fighters = arg,
_adornFolder = folder,
_descendantAddedConnection = nil,
_hooksBySound = {},
_lastPlayedAtBySound = {},
_activeEffects = {},
_circlePool = {},
_footprintPool = {},
}

setmetatable(tbl20, index2)
tbl20:_Initialize()
return tbl20
end

index2._Initialize = function(arg)
arg._trove:Connect(v115:GetPropertyChangedSignal({ "SoundVisualizer", "Enabled" }), function(arg2)
arg:_SetEnabled(arg2)
end)

arg:_SetEnabled(v115.Data.SoundVisualizer.Enabled)
end

index2._SetEnabled = function(arg, arg2)
if arg2 == arg._descendantAddedConnection ~= nil then
return
end

if arg2 then
arg:_StartTracking()
else
arg:_StopTracking()
end
end

index2._StartTracking = function(arg)
arg._descendantAddedConnection = v118.DescendantAdded:Connect(function(descendant)
if descendant:IsA("Sound") then
arg:_TrackSound(descendant)
end
end)

for _, v119 in v118:QueryDescendants("Sound") do
arg:_TrackSound(v119)
end
end

index2._StopTracking = function(arg)
local descendantAddedConnection = arg._descendantAddedConnection
if descendantAddedConnection == nil then
return
end
arg._descendantAddedConnection = nil
descendantAddedConnection:Disconnect()

for _, v119 in arg._hooksBySound, nil, nil do
v119.Played:Disconnect()
v119.Destroying:Disconnect()
end

table.clear(arg._hooksBySound)
table.clear(arg._lastPlayedAtBySound)
end

index2._TrackSound = function(arg, arg2)
if arg._descendantAddedConnection == nil or arg._hooksBySound[arg2] ~= nil then
return
end

arg._hooksBySound[arg2] = {
Played = arg2.Played:Connect(function()
if true then
arg:_OnPlayed(arg2)
return
end

while true do
end
end),
Destroying = arg2.Destroying:Connect(function()
arg:_ForgetSound(arg2)
end),
}
end

index2._ForgetSound = function(arg, arg2)
local v119 = arg._hooksBySound[arg2]
if v119 == nil then
return
end
arg._hooksBySound[arg2] = nil
arg._lastPlayedAtBySound[arg2] = nil
v119.Played:Disconnect()
v119.Destroying:Disconnect()
end

index2._AcquireCircle = function(arg)
local cylinderHandleAdornment = table.remove(arg._circlePool)

if cylinderHandleAdornment == nil then
cylinderHandleAdornment = Instance.new("CylinderHandleAdornment")
cylinderHandleAdornment.Adornee = v118.Terrain
cylinderHandleAdornment.AlwaysOnTop = true
cylinderHandleAdornment.ZIndex = 5
cylinderHandleAdornment.Height = 0.05
cylinderHandleAdornment.Angle = 360
cylinderHandleAdornment.Parent = arg._adornFolder
end

cylinderHandleAdornment.Visible = true
return cylinderHandleAdornment
end

index2._AcquireFootprint = function(arg)
local boxHandleAdornment = table.remove(arg._footprintPool)

if boxHandleAdornment == nil then
boxHandleAdornment = Instance.new("BoxHandleAdornment")
boxHandleAdornment.Adornee = v118.Terrain
boxHandleAdornment.AlwaysOnTop = true
boxHandleAdornment.ZIndex = 5
boxHandleAdornment.Parent = arg._adornFolder
end

boxHandleAdornment.Visible = true
return boxHandleAdornment
end

index2._RecycleEffect = function(arg, arg2)
local adornment = arg2.Adornment
adornment.Visible = false

if arg2.IsCircle then
if #arg._circlePool < 32 then
table.insert(arg._circlePool, adornment)
return
end
elseif #arg._footprintPool < 32 then
table.insert(arg._footprintPool, adornment)
