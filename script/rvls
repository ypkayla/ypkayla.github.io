arg._outstandingAmmoSpend = math.max(arg._outstandingAmmoSpend - expectedAmmoRaw - ammo, constants[186])
arg._expectedAmmoRaw = ammo

if arg._outstandingAmmoSpend <= 0 then
arg._outstandingAmmoSpendDeadline = nil
end
end

