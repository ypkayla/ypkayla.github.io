index2.Update = function(arg, arg2)
local targetPart = arg._targetPart

if targetPart == nil or arg2 then
if arg._visible then
arg._visible = false
arg._line.Visible = false
arg._outline.Visible = false
end

return
end

local position = targetPart.Position

if arg._target == "Feet" then
position -= Vector3.new(0, targetPart.Size.Y * 0.5 + 2, 0)
end

local v118, v119 = v117(position)

if v119 <= 0 then
if arg._visible then
arg._visible = false
arg._line.Visible = false
arg._outline.Visible = false
end

return
end

local viewportSize = workspace.CurrentCamera.ViewportSize
local origin = arg._origin
local vector2

if origin == "Bottom" then
vector2 = Vector2.new(viewportSize.X * 0.5, viewportSize.Y)
elseif origin == "Center" then
vector2 = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)
elseif origin == "Top" then
vector2 = Vector2.new(viewportSize.X * 0.5, 0)
else
local mouseLocation = UserInputService:GetMouseLocation()
vector2 = Vector2.new(mouseLocation.X, mouseLocation.Y)
end

local thickness = arg._thickness
v116(arg._line, vector2, v118, thickness)

if arg._outlineEnabled then
v116(arg._outline, vector2, v118, thickness + arg._outlineThickness * 2)

if not arg._outline.Visible then
arg._outline.Visible = true
end
elseif arg._outline.Visible then
arg._outline.Visible = false
end

if not arg._visible then
arg._visible = true
arg._line.Visible = constants[34]
end
end

