local function fn35()
local v115 = modules.f()
local v116 = modules.gX()
local v117 = modules.ad()
local v118 = modules.a()
local v119 = modules.g()
modules.gW()
local str7 = string.format("%s/%s", "GHPrebuild/rivals", "skyboxes.json")

local tbl18 = {
SkyboxBk = "string",
SkyboxDn = constants[165],
SkyboxFt = "string",
SkyboxLf = "string",
SkyboxRt = "string",
SkyboxUp = "string",
StarCount = "number",
CelestialBodiesShown = "boolean",
SunAngularSize = constants[95],
MoonAngularSize = constants[95],
SunTextureId = constants[165],
MoonTextureId = "string",
}

local tbl19 = { "SkyboxUp", "SkyboxDn", "SkyboxFt", "SkyboxBk", "SkyboxLf", "SkyboxRt" }

local function fn36(arg)
return arg:match("^%s*(.-)%s*$") or ""
end

local function fn37(arg)
if type(arg) == "number" then
return string.format("rbxassetid://%s", tostring(arg))
end

if type(arg) ~= "string" then
return nil
end
local v120 = fn36(arg)
if v120 == "" then
return nil
end
local match = v120:match("^(%d+)$")
if match ~= nil then
return string.format("rbxassetid://%s", tostring(match))
end
return v120
end

local function fn38(arg)
local tbl20 = {}

for k, v120 in arg, nil, nil do
local v121 = tbl18[k]

if type(v120) == v121 then
tbl20[k] = v120
end
end

return tbl20
end

local function fn39(arg)
local tbl20 = {}
local v120 = constants[68]
arg = type(arg) == v120 and arg or nil

if arg ~= nil then
for k, v121 in arg, nil, nil do
if not (type(k) ~= "string" or type(v121) ~= "table") then
if not (k == "" or tbl20[k] ~= nil) then
tbl20[k] = fn38(v121)
end
end
end
end

return tbl20
end

local index2 = {}
index2.__index = index2

index2.new = function()
local tbl20 = {
_errorReporter = v117.new(),
_configManager = v115.new({
DefaultConfig = v116,
CurrentVersion = constants[63],
SavePath = "GHPrebuild/rivals",
Deserialize = fn39,
}),
_data = table.clone(v116),
_names = {},
_presetByName = {},
Changed = v119.new(),
}

setmetatable(tbl20, index2)
return tbl20
end

index2.Initialize = function(arg)
arg._errorReporter:ReportResult(arg:_EnsureDefaultFile())
arg._errorReporter:ReportResult(arg:Reload())
end

index2._EnsureDefaultFile = function(arg)
if isfile(str7) then
return v118.VoidOk
end
local json = arg._configManager:SaveDefaultToFile("skyboxes.json", true)
if not json.Ok then
return v118.err("Skyboxes", "EnsureDefaultFile", string.format("Failed to create default skybox config: %s", tostring(json.Error.Detail)))
end
return v118.VoidOk
end

index2.Reload = function(arg)
arg:_EnsureDefaultFile()
local json = arg._configManager:LoadFromFile("skyboxes.json")

if not json.Ok then
arg._data = table.clone(v116)
arg:_RebuildIndexes()
arg.Changed:Fire(arg:GetNames())
return v118.err("Skyboxes", "Reload", json.Error.Detail)
end

arg._data = json.Value
arg:_RebuildIndexes()
arg.Changed:Fire(arg:GetNames())
return v118.VoidOk
end

index2._RebuildIndexes = function(arg)
local names = {}
local presetByName = {}

for k, v120 in arg._data, nil, nil do
table.insert(names, k)
presetByName[k] = v120
end

table.sort(names)
arg._names = names
arg._presetByName = presetByName
end

index2.GetNames = function(arg)
return table.clone(arg._names)
end

index2.FindPreset = function(arg, arg2)
return arg2 ~= nil and arg._presetByName[arg2] or nil
end

index2._Save = function(arg)
arg._configManager:SetData(arg._data)
local json = arg._configManager:SaveToFile("skyboxes.json")
if not json.Ok then
return v118.err("Skyboxes", "Save", json.Error.Detail)
end
return v118.VoidOk
end

index2.Add = function(arg, arg2, arg3)
local v120 = fn36(arg2)
if v120 == "" then
return v118.err("Skyboxes", "Add", "skybox name cannot be empty")
end

if arg._presetByName[v120] ~= nil then
return v118.err("Skyboxes", "Add", string.format("a skybox named \"%s\" already exists", tostring(v120)))
end
local tbl20 = {}

for _, v121 in tbl19, nil, nil do
local v122 = fn37(arg3[v121])
if v122 == nil then
return v118.err("Skyboxes", "Add", "all six skybox faces are required")
end
tbl20[v121] = v122
end

arg._data[v120] = tbl20
arg:_RebuildIndexes()
local v121 = arg:_Save()
arg.Changed:Fire(arg:GetNames())
return v121
end

index2.Remove = function(arg, arg2)
if arg._data[arg2] == nil then
return v118.VoidOk
end
arg._data[arg2] = nil
arg:_RebuildIndexes()
local v120 = arg:_Save()
arg.Changed:Fire(arg:GetNames())
return v120
end

index2.Destroy = function(arg)
arg._errorReporter:Destroy()
arg.Changed:Destroy()
end

return index2
end

