arg._loopConnection = v118.RenderStepped:Connect(function()
arg:_Update()
end)

if arg2 then
arg._awaitingOwnership = constants[34]
end
end

index2._Update = function(arg)
local track = arg._track
if track == nil then
return
end

if not track.IsPlaying then
arg._track = nil
arg:_Apply()
return
end

local humanoid = arg._humanoid

if arg._awaitingOwnership and humanoid ~= nil then
if humanoid.RootPart ~= nil then
arg._awaitingOwnership = false
arg:_Apply()
return
end
end

arg:_EnforceWindow(track)
end

index2._EnforceWindow = function(arg, arg2)
local length = arg2.Length
if length <= constants[186] then
return
end
local animationPlayer = v116.Data.AnimationPlayer
local timePosition = math.clamp(animationPlayer.Start, 0, 100) / 100 * length
local n = math.clamp(animationPlayer.End, 0, 100) / 100 * length
if n <= timePosition then
return
end

if arg2.TimePosition >= n or arg2.TimePosition < timePosition then
arg2.TimePosition = timePosition
end
end

index2._Stop = function(arg)
if arg._animatorWait ~= nil then
arg._animatorWait:Disconnect()
arg._animatorWait = nil
end

if arg._loopConnection ~= nil then
arg._loopConnection:Disconnect()
arg._loopConnection = nil
end

local track = arg._track

if track ~= nil then
track:Stop()
track:Destroy()
arg._track = nil
end
end

index2.Destroy = function(arg)
arg:_Stop()
arg._trove:Destroy()
end

return index2
end

